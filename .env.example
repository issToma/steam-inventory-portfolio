# Copy to .env and adjust. Never commit .env.

# Postgres credentials used by docker-compose.yml.
POSTGRES_USER=invinv
POSTGRES_PASSWORD=change-me
POSTGRES_DB=invinv
# Postgres image; any Postgres 16+ works.
POSTGRES_IMAGE=postgres:18.1-alpine
# Host port for Postgres; change it if 5432 is already taken. Keep INVINV_DATABASE_URL in sync.
POSTGRES_HOST_PORT=5432

# Host port for the web UI.
APP_HOST_PORT=8080

# Database URL for running the app outside Docker (inside Docker it is set by docker-compose.yml).
INVINV_DATABASE_URL=postgresql+asyncpg://invinv:change-me@localhost:5432/invinv

# Seconds between requests to Steam. Minimum 8; please do not go lower than the default.
INVINV_REQUEST_INTERVAL_SECONDS=20

# Opt-in: requests go INVINV_ADAPTIVE_MIN_INTERVAL_SECONDS apart (at least 5 s) until Steam
# answers "429 Too Many Requests", then INVINV_REQUEST_INTERVAL_SECONDS apart. Off by default.
INVINV_ADAPTIVE_PACING=false
INVINV_ADAPTIVE_MIN_INTERVAL_SECONDS=5

# Signs the browser storage and encrypts the Telegram token in the database. Use any long
# random string; changing it later means entering the Telegram token again.
INVINV_UI_STORAGE_SECRET=change-me

# Port when running the app outside Docker (uv run invinv).
INVINV_PORT=8080
