# Copy to .env and adjust. Never commit .env.

# Postgres credentials used by docker-compose.yml.
POSTGRES_USER=cs2market
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cs2market

# Database URL for running the app outside Docker (inside Docker it is set by docker-compose.yml).
CS2M_DATABASE_URL=postgresql+asyncpg://cs2market:change-me@localhost:5432/cs2market

# Seconds between requests to Steam. Minimum 15; please do not go lower than the default.
CS2M_REQUEST_INTERVAL_SECONDS=20

# Secret for NiceGUI browser storage. Use any long random string.
CS2M_UI_STORAGE_SECRET=change-me
